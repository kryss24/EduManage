# ===========================================================================
# Fichier d'exemple des variables d'environnement.
# Copier en ".env" (jamais commité) et adapter les valeurs :
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Module de réglages à utiliser : config.settings.dev | prod | test
DJANGO_SETTINGS_MODULE=config.settings.dev

# Clé secrète Django. À générer et à garder strictement privée en prod.
# Ex. : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-une-vraie-cle-secrete-en-production

# Active le mode debug (jamais True en production)
DEBUG=True

# Hôtes autorisés à servir l'application, séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Origines autorisées à appeler l'API en CORS (le futur frontend React)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Authentification JWT (SCRUM-8)
# ---------------------------------------------------------------------------
# Clé de signature DÉDIÉE aux JWT. DOIT être distincte de SECRET_KEY et
# contenir au moins 32 caractères aléatoires en production.
# Ex. : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=change-me-une-cle-jwt-dediee-distincte-du-secret-key-32chars-min

# Durée de vie de l'access token (minutes) et du refresh token (heures).
# La rotation du refresh à chaque appel à /api/auth/refresh/ redonne
# JWT_REFRESH_HOURS : une session est donc coupée après ce temps d'inactivité.
JWT_ACCESS_MINUTES=10
JWT_REFRESH_HOURS=8

# Émetteur/audience vérifiés dans chaque JWT.
JWT_ISSUER=edumanage-api
JWT_AUDIENCE=edumanage-frontend

# Attributs du cookie HttpOnly portant le refresh token.
# SameSite=Lax/Strict suppose que /api/* passe par le même domaine racine
# que le frontend (voir README « Topologie de déploiement »). SameSite=None
# n'est à utiliser qu'en dernier recours (cross-site), avec Secure=True.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=False

# Nombre de proxys inverses en amont de l'application (load balancer...),
# utilisé pour déterminer la vraie IP cliente depuis X-Forwarded-For.
NUM_PROXIES=0

# ---------------------------------------------------------------------------
# Superadmin de départ (manage.py bootstrap_superadmin)
# ---------------------------------------------------------------------------
# Vide par défaut : à renseigner uniquement pour lancer bootstrap_superadmin,
# puis à retirer de l'environnement en production.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=CHANGE_ME_with_a_strong_password
SUPERADMIN_NOM=Administrateur
SUPERADMIN_PRENOM=Super

# ---------------------------------------------------------------------------
# Base de données PostgreSQL
# ---------------------------------------------------------------------------
# URL complète utilisée par Django (django-environ). Doit rester cohérente
# avec les variables POSTGRES_* ci-dessous lorsqu'on utilise docker-compose.
DATABASE_URL=postgres://ecole:ecole@db:5432/ecole

# Variables utilisées par le service "db" de docker-compose
POSTGRES_DB=ecole
POSTGRES_USER=ecole
POSTGRES_PASSWORD=ecole
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Données de démonstration (manage.py seed_demo_data)
# ---------------------------------------------------------------------------
# Mot de passe appliqué à tous les comptes de démonstration créés par
# `seed_demo_data`. Obligatoire, doit respecter les règles de mot de passe
# de Django, et ne doit JAMAIS être laissé à sa valeur d'exemple ci-dessous
# (la commande refuse de s'exécuter si c'est le cas).
SEED_USER_PASSWORD=CHANGE_ME_avant_de_lancer_le_seed
