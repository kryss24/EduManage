# ===========================================================================
# Fichier d'exemple des variables d'environnement.
# Copier en ".env" (jamais commité) et adapter les valeurs :
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Module de réglages à utiliser : config.settings.dev | prod | test
DJANGO_SETTINGS_MODULE=config.settings.dev

# Clé secrète Django. À générer et à garder strictement privée en prod.
# Ex. : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-une-vraie-cle-secrete-en-production

# Active le mode debug (jamais True en production)
DEBUG=True

# Hôtes autorisés à servir l'application, séparés par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Origines autorisées à appeler l'API en CORS (le futur frontend React)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Base de données PostgreSQL
# ---------------------------------------------------------------------------
# URL complète utilisée par Django (django-environ). Doit rester cohérente
# avec les variables POSTGRES_* ci-dessous lorsqu'on utilise docker-compose.
DATABASE_URL=postgres://ecole:ecole@db:5432/ecole

# Variables utilisées par le service "db" de docker-compose
POSTGRES_DB=ecole
POSTGRES_USER=ecole
POSTGRES_PASSWORD=ecole
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Données de démonstration (manage.py seed_demo_data)
# ---------------------------------------------------------------------------
# Mot de passe appliqué à tous les comptes de démonstration créés par
# `seed_demo_data`. Obligatoire, doit respecter les règles de mot de passe
# de Django, et ne doit JAMAIS être laissé à sa valeur d'exemple ci-dessous
# (la commande refuse de s'exécuter si c'est le cas).
SEED_USER_PASSWORD=CHANGE_ME_avant_de_lancer_le_seed
